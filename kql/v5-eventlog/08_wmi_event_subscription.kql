// DeviceEvents
// | where Timestamp > ago(30d)
// | where ActionType in ("WmiBindEventFilterToConsumer","AsyncEventConsumerCreated","EventFilterCreated")
// | extend Phase = "Persistence-WMISubscription"
// | project Timestamp, DeviceName, ActionType, InitiatingProcessFileName,
//           InitiatingProcessCommandLine, AdditionalFields, Phase
// | order by Timestamp desc
